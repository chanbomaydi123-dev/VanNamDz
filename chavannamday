local function addLog(name, status, detail)
	local entry = {
		time = os.date("%H:%M:%S"),
		name = name,
		status = status,
		detail = detail,
	}
	table.insert(logs, 1, entry)
	while #logs > 100 do table.remove(logs) end

	if resultLabel and activeTab == "Nhật ký" then
		local lines = {}
		for i = 1, math.min(#logs, 15) do
			local item = logs[i]
			table.insert(lines, string.format("[%s] %s — %s\n> %s", item.time, item.name, item.status, item.detail))
		end
		resultLabel.Text = table.concat(lines, "\n\n")
	end

	notify(name, status .. ": " .. string.sub(detail, 1, 35) .. (string.len(detail) > 35 and "..." or ""))
end

local function newPage(name)
	local page = make("ScrollingFrame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = C.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
	}, content)

	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, page)
	make("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }, page)

	pages[name] = page
	return page
end

local function switchTab(name)
	activeTab = name
	for pageName, page in pairs(pages) do page.Visible = (pageName == name) end
	for btnName, btn in pairs(tabButtons) do
		local isActive = (btnName == name)
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = isActive and C.Accent or C.Card,
			TextColor3 = isActive and C.Text or C.Muted
		}):Play()
	end
end

local function addTab(name, iconChar)
	local b = button(sidebar, (iconChar or "•") .. "   " .. name, function() switchTab(name) end)
	b.Size = UDim2.new(1, 0, 0, 36)
	b.LayoutOrder = #pages + 1
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextColor3 = C.Muted
	tabButtons[name] = b
	return b
end

