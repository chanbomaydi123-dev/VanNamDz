-- Các hàm hỗ trợ giao diện
local function round(obj, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	corner.Parent = obj
	return corner
end

local function stroke(obj, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or C.Accent
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.55
	s.Parent = obj
	return s
end

local function make(className, props, parent)
	local obj = Instance.new(className)
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function label(parent, text, size, color)
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.GothamMedium,
		TextSize = size or 12,
		TextColor3 = color or C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}, parent)
end

-- Nút bấm tương tác VIP kèm hiệu ứng
local function button(parent, text, callback, isAccent)
	local btn = make("TextButton", {
		BackgroundColor3 = isAccent and C.Accent or C.Card,
		Text = text,
		TextColor3 = C.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		AutoButtonColor = false,
	}, parent)
	round(btn, 8)
	stroke(btn, isAccent and C.AccentHover or C.Accent, 1, 0.7)

	local defaultColor = isAccent and C.Accent or C.Card
	local hoverColor = isAccent and C.AccentHover or C.CardHover

	btn.MouseEnter:Connect(function()
		playHover()
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = defaultColor}):Play()
	end)

	btn.Activated:Connect(function()
		playClick()
		local origSize = btn.Size
		TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.new(origSize.X.Scale, origSize.X.Offset - 4, origSize.Y.Scale, origSize.Y.Offset - 2)}):Play()
		task.wait(0.08)
		TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Back), {Size = origSize}):Play()
		callback()
	end)

	return btn
end

