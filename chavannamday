local function playSound(id, pitch)
	task.spawn(function()
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. id
		s.Volume = 0.3
		s.PlaybackSpeed = pitch or 1
		s.Parent = soundFolder
		s:Play()
		s.Ended:Wait()
		s:Destroy()
	end)
end

