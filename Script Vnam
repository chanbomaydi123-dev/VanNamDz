		Lighting.Brightness = 2
		addLog("Full Bright", "ENABLED", "Lighting modified for audit clarity.")
	else
		Lighting.Ambient = oldAmbient or Color3.fromRGB(128, 128, 128)
		Lighting.Brightness = oldBrightness or 1
		addLog("Full Bright", "DISABLED", "Restored standard lighting.")
	end
end)

