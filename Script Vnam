local function notify(titleText, msg)
	local toast = make("Frame", {
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		Position = UDim2.new(1, 50, 0, 0),
	}, toastContainer)
	round(toast, 8)
	stroke(toast, C.Accent, 1, 0.3)

	local tTitle = label(toast, "✦ " .. titleText, 11, C.Accent)
	tTitle.Position = UDim2.fromOffset(10, 6)
	tTitle.Size = UDim2.new(1, -20, 0, 14)

	local tDesc = label(toast, msg, 10, C.Muted)
	tDesc.Position = UDim2.fromOffset(10, 22)
	tDesc.Size = UDim2.new(1, -20, 0, 20)

	-- Slide In Animation
	toast.Position = UDim2.new(1, 100, 0, 0)
	TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()

	task.delay(3.5, function()
		local tw = TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 100, 0, 0)})
		tw:Play()
		tw.Completed:Wait()
		toast:Destroy()
	end)
end

